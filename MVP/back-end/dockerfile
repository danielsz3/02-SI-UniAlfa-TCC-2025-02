# --- Estágio 1: Builder ---
# Usamos a mesma versão base para garantir compatibilidade
FROM php:8.2-apache AS builder

# Instala dependências do sistema necessárias para o Composer e extensões
RUN apt-get update && apt-get install -y \
    git unzip curl libpng-dev libonig-dev libxml2-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd

# Instala o Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Define o diretório de trabalho
WORKDIR /var/www

# Copia apenas os arquivos de dependência primeiro (para aproveitar o cache do Docker)
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --optimize-autoloader

# Copia o restante do código
COPY . .

# --- Estágio 2: Imagem Final ---
FROM php:8.2-apache

# Define a variável para a pasta public do Laravel
ENV APACHE_DOCUMENT_ROOT=/var/www/public

# Instala dependências de execução e o netcat (para o entrypoint)
RUN apt-get update && apt-get install -y \
      libpng-dev libonig-dev libxml2-dev netcat-openbsd \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd

# Habilita o mod_rewrite do Apache (Necessário para rotas do Laravel)
RUN a2enmod rewrite

# Ajusta a configuração do Apache para apontar para /var/www/public
# Isso substitui o padrão /var/www/html pelo nosso caminho correto
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# Define o diretório de trabalho
WORKDIR /var/www

# Copia os arquivos do estágio de build
COPY --from=builder /var/www /var/www

# ----------------- ENTRYPOINT -----------------
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]
# ----------------------------------------------

# O Apache escuta na porta 80 por padrão.
# O Cloud Run vai redirecionar o tráfego para cá automaticamente.
EXPOSE 80

# Inicia o Apache em primeiro plano
CMD ["apache2-foreground"]